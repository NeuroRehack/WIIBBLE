# WIIBBLE environment variables (all optional)
#
# Copy to .env for local overrides, or export in your shell.
# WIIBBLE does not require secrets in normal operation.

# Override path to settings.json (default: %APPDATA%\WIIBBLE\settings.json on Windows,
# ~/.wiibble/settings.json elsewhere). Used by tests and custom deployments.
# WIIBBLE_SETTINGS_PATH=/path/to/settings.json
